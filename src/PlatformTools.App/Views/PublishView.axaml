<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:m="using:PlatformTools.App.Models" xmlns:c="using:PlatformTools.App.Controls" x:Class="PlatformTools.App.Views.PublishView">
  <Grid RowDefinitions="Auto,*" Margin="36,20,36,28">
    <StackPanel Spacing="16" Margin="0,0,0,18">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="7"><TextBlock Text="发布服务" FontSize="28" FontWeight="Bold"/><TextBlock Text="多个服务可同时运行，配置会自动保留。" Classes="muted" FontSize="13" TextWrapping="Wrap"/></StackPanel>
        <Button Grid.Column="1" Classes="primary" x:Name="AddButton" Content="新增服务" Click="Add_Click" VerticalAlignment="Center" Margin="16,0,0,0"/>
      </Grid>
      <Grid ColumnDefinitions="*,12,*,12,*">
        <Border Classes="surface" Padding="18,14" CornerRadius="12"><StackPanel Spacing="6"><TextBlock Text="服务总数" Classes="eyebrow"/><TextBlock x:Name="TotalCountText" Text="0" FontSize="25" FontWeight="SemiBold"/></StackPanel></Border>
        <Border Grid.Column="2" Classes="surface" Padding="18,14" CornerRadius="12"><StackPanel Spacing="6"><TextBlock Text="运行中" Classes="eyebrow"/><TextBlock x:Name="RunningCountText" Text="0" FontSize="25" FontWeight="SemiBold" Foreground="#36B58B"/></StackPanel></Border>
        <Border Grid.Column="4" Classes="surface" Padding="18,14" CornerRadius="12"><StackPanel Spacing="6"><TextBlock Text="异常" Classes="eyebrow"/><TextBlock x:Name="FailedCountText" Text="0" FontSize="25" FontWeight="SemiBold" Foreground="#D57A31"/></StackPanel></Border>
      </Grid>
      <Grid ColumnDefinitions="*,Auto"><TextBlock x:Name="SummaryText" Classes="muted" FontSize="12" VerticalAlignment="Center"/><Button Grid.Column="1" Classes="quiet" Content="账号设置" Click="AccountSettings_Click"/></Grid>
      <TextBlock x:Name="MessageText" Foreground="#D57A31" TextWrapping="Wrap" IsVisible="False"/>
    </StackPanel>
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <Border x:Name="EmptyState" Classes="surface" Padding="32" MinHeight="220"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14"><Border Width="52" Height="52" Background="{DynamicResource AccentSoftBrush}" CornerRadius="16" HorizontalAlignment="Center"><TextBlock Text="＋" FontSize="28" Foreground="#3087EF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="还没有发布服务" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="添加本地网页、接口或远程连接，按需独立启动。" Classes="muted" FontSize="13" TextWrapping="Wrap"/><Button Classes="primary" Content="新增服务" Click="Add_Click" HorizontalAlignment="Center"/></StackPanel></Border>
        <ItemsControl x:Name="ServiceItems"><ItemsControl.ItemTemplate><DataTemplate x:DataType="m:PublishedService"><c:PublishedServiceRow ActionRequested="ServiceAction_Requested"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
