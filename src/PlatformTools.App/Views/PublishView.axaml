<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="PlatformTools.App.Views.PublishView">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="40,28,40,36" Spacing="18" MaxWidth="920">
      <TextBlock Text="发布本地服务" FontSize="30" FontWeight="Bold" Foreground="#101828"/>
      <TextBlock Text="告诉我们服务在哪里，其余工作交给 Platform Tools。" Foreground="#697386" FontSize="15"/>
      <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="16" Padding="26" Margin="0,10,0,0">
        <StackPanel Spacing="20">
          <StackPanel Spacing="8"><TextBlock Text="服务类型" FontWeight="SemiBold"/><ComboBox x:Name="ProtocolBox" SelectedIndex="0" SelectionChanged="Protocol_Changed"><ComboBoxItem Content="HTTP / HTTPS（网页或 API）"/><ComboBoxItem Content="SSH"/><ComboBoxItem Content="远程桌面 RDP"/><ComboBoxItem Content="数据库"/><ComboBoxItem Content="SMB 文件共享"/><ComboBoxItem Content="自定义 TCP"/></ComboBox></StackPanel>
          <StackPanel Spacing="8"><TextBlock Text="本地服务地址" FontWeight="SemiBold"/><TextBox x:Name="LocalUrlBox" Text="http://localhost:8080" PlaceholderText="例如 8080 或 http://localhost:8080"/><TextBlock Text="只填写端口时，会自动使用 http://localhost。" Foreground="#7B8798" FontSize="12"/></StackPanel>
          <StackPanel Spacing="8"><TextBlock Text="发布方式" FontWeight="SemiBold"/><Grid ColumnDefinitions="*,14,*"><RadioButton x:Name="QuickMode" Content="临时地址（无需登录）" IsChecked="True" GroupName="mode" Click="Mode_Changed"/><RadioButton x:Name="NamedMode" Grid.Column="2" Content="使用自己的域名" GroupName="mode" Click="Mode_Changed"/></Grid></StackPanel>
          <Border x:Name="QuickHint" Background="#FFF8EC" CornerRadius="10" Padding="14"><TextBlock Text="临时地址适合开发和演示：地址随机生成，停止后失效，最多支持 200 个并发请求。" Foreground="#8A5A16" TextWrapping="Wrap" FontSize="13"/></Border>
          <Border x:Name="NamedOptions" IsVisible="False" Background="#F5F8FE" CornerRadius="12" Padding="18"><StackPanel Spacing="14"><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="Cloudflare 账户" FontWeight="SemiBold"/><TextBlock Text="首次使用需要在浏览器中授权" Foreground="#697386" FontSize="12"/></StackPanel><Button Grid.Column="1" Content="登录 / 重新授权" Click="Login_Click"/></Grid><StackPanel Spacing="7"><TextBlock Text="隧道名称" FontWeight="SemiBold"/><TextBox x:Name="TunnelNameBox" Text="platform-tools" PlaceholderText="例如 platform-tools"/></StackPanel><StackPanel Spacing="7"><TextBlock Text="完整公网域名" FontWeight="SemiBold"/><TextBox x:Name="HostnameBox" PlaceholderText="例如 demo.example.com"/></StackPanel><Grid ColumnDefinitions="*,12,*"><StackPanel Spacing="7"><TextBlock Text="访问权限" FontWeight="SemiBold"/><ComboBox x:Name="AccessModeBox" SelectedIndex="0" SelectionChanged="AccessMode_Changed"><ComboBoxItem Content="公开访问"/><ComboBoxItem Content="身份保护"/></ComboBox></StackPanel><StackPanel Grid.Column="2" Spacing="7"><TextBlock Text="建议连接端口" FontWeight="SemiBold"/><NumericUpDown x:Name="SuggestedPortBox" Minimum="1" Maximum="65535" Value="8080"/></StackPanel></Grid><Border x:Name="AccessOptions" IsVisible="False" Background="#FFF8EC" CornerRadius="10" Padding="14"><StackPanel Spacing="10"><TextBlock Text="Cloudflare Access 身份保护" FontWeight="SemiBold"/><TextBox x:Name="AccountIdBox" PlaceholderText="Cloudflare Account ID"/><TextBox x:Name="ApiTokenBox" PasswordChar="●" PlaceholderText="API Token（仅在内存中使用，不会保存）"/><TextBox x:Name="AllowedEmailsBox" PlaceholderText="允许的邮箱，多个邮箱用逗号分隔"/><TextBlock Text="API Token 需要 Access: Apps and Policies Write 权限。" Foreground="#8A5A16" FontSize="12"/></StackPanel></Border></StackPanel></Border>
          <StackPanel Orientation="Horizontal" Spacing="12"><Button x:Name="StartButton" Content="开始发布" Background="#1677FF" Foreground="White" CornerRadius="9" Padding="26,11" Click="Start_Click"/><Button x:Name="StopButton" Content="停止" CornerRadius="9" Padding="22,11" IsEnabled="False" Click="Stop_Click"/></StackPanel>
        </StackPanel>
      </Border>
      <Border x:Name="ResultCard" IsVisible="False" Background="#ECFAF4" BorderBrush="#BFEBD7" BorderThickness="1" CornerRadius="16" Padding="22">
        <StackPanel Spacing="10"><TextBlock Text="发布成功" Foreground="#16704C" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="PublicUrlText" Foreground="#135D9C" FontSize="16" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Spacing="10"><Button Content="复制地址" Click="Copy_Click"/><Button x:Name="OpenBrowserButton" Content="浏览器打开" Click="Open_Click"/><Button x:Name="CopyShareButton" Content="复制分享码" IsVisible="False" Click="CopyShare_Click"/><Button x:Name="SaveShareButton" Content="保存 .ptlink" IsVisible="False" Click="SaveShare_Click"/></StackPanel></StackPanel>
      </Border>
      <Expander Header="运行日志" IsExpanded="False"><Border Background="#101828" CornerRadius="10" Padding="14"><TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="130" MaxHeight="240" Background="Transparent" Foreground="#C8D3E1" BorderThickness="0" FontFamily="Cascadia Mono, monospace"/></Border></Expander>
    </StackPanel>
  </ScrollViewer>
</UserControl>
