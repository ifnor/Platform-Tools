<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="using:PlatformTools.App.Models" xmlns:c="using:PlatformTools.App.Controls" x:Class="PlatformTools.App.Views.HomeView">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="36,12,36,32" Spacing="22" MaxWidth="1160">
      <Grid ColumnDefinitions="3*,2*" MinHeight="190">
        <StackPanel VerticalAlignment="Center" Spacing="12">
          <TextBlock Text="LOCAL TO WORLD" FontSize="11" FontWeight="SemiBold" LetterSpacing="2.5" Foreground="#3087EF"/>
          <TextBlock Text="让本地服务安全上线" FontSize="32" FontWeight="Bold" LetterSpacing="-0.7" TextWrapping="Wrap"/>
          <TextBlock Text="无需命令行，几步即可发布或连接服务" FontSize="14" Classes="muted" TextWrapping="Wrap"/>
          <TextBlock x:Name="ServiceSummary" FontSize="12" Foreground="#3087EF" TextWrapping="Wrap"/>
        </StackPanel>
        <c:ConnectionIllustration Grid.Column="1" MaxWidth="350" Margin="4,0,0,0"/>
      </Grid>
      <Grid ColumnDefinitions="*,20,*">
        <c:ActionCard Heading="发布本地服务" Description="将这台电脑上的服务分享出去" IconData="M3 10 L22 2 L14 22 L10 14 Z M10 14 L16 8" Click="Publish_Click" Foreground="White" BorderThickness="0">
          <c:ActionCard.Background><LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%"><GradientStop Color="#319FFF"/><GradientStop Offset="1" Color="#1768EC"/></LinearGradientBrush></c:ActionCard.Background>
        </c:ActionCard>
        <c:ActionCard Grid.Column="2" Heading="连接分享服务" Description="使用分享码或 .ptlink 文件连接" IconData="M9 6 L11 8 L7 12 A3 3 0 0 0 11 16 L15 12 L17 14 L13 18 A6 6 0 0 1 5 10 Z M15 18 L13 16 L17 12 A3 3 0 0 0 13 8 L9 12 L7 10 L11 6 A6 6 0 0 1 19 14 Z" Click="Connect_Click"/>
      </Grid>
      <Border Classes="surface" Padding="24" MinHeight="216">
        <Grid RowDefinitions="36,*">
          <TextBlock Text="最近使用" FontSize="17" FontWeight="SemiBold"/>
          <Border Grid.Row="1" Background="{DynamicResource SoftBrush}" CornerRadius="12" Margin="0,8,0,0" x:Name="EmptyState">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Margin="16,20">
              <Path Data="M10 2 H30 A5 5 0 0 1 35 7 V33 A5 5 0 0 1 30 38 H10 A5 5 0 0 1 5 33 V7 A5 5 0 0 1 10 2 M13 13 H27 M13 20 H27 M13 27 H22" Width="40" Height="40" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.7" StrokeLineCap="Round" Opacity="0.55"/>
              <TextBlock Text="暂无最近使用的服务" Classes="muted" FontSize="13"/>
            </StackPanel>
          </Border>
          <ItemsControl x:Name="RecentItems" Grid.Row="1" IsVisible="False">
            <ItemsControl.ItemTemplate><DataTemplate x:DataType="models:RecentService">
              <Border Padding="14,12" Margin="0,4" CornerRadius="12" Background="{DynamicResource SoftBrush}">
                <Grid ColumnDefinitions="74,*,Auto"><Border CornerRadius="6" Background="{DynamicResource AccentSoftBrush}" Padding="8,5" VerticalAlignment="Center" HorizontalAlignment="Left"><TextBlock Text="{Binding Protocol}" FontSize="11" FontWeight="SemiBold" Foreground="#3087EF"/></Border><StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Address}" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding LastUsedUtc, StringFormat='{}{0:MM-dd HH:mm}'}" Classes="muted" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0"/></Grid>
              </Border>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
