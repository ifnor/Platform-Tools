<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="using:PlatformTools.App.Models" x:Class="PlatformTools.App.Views.HomeView">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="34,24,34,34" Spacing="22" MaxWidth="1100">
      <Grid ColumnDefinitions="*,260" MinHeight="150">
        <StackPanel VerticalAlignment="Center" Spacing="10"><TextBlock Text="让本地服务安全上线" FontSize="36" FontWeight="Bold" Foreground="#101828"/><TextBlock Text="无需命令行，几步即可发布或连接服务" FontSize="17" Foreground="#697386" TextWrapping="Wrap"/></StackPanel>
        <Border Grid.Column="1" CornerRadius="75" Width="150" Height="150" Background="#FFF4E8" HorizontalAlignment="Center"><PathIcon Width="82" Height="82" Foreground="#FFA446" Data="M6,19A5,5 0 0,1 5,9A7,7 0 0,1 18,7A5,5 0 0,1 18,19Z"/></Border>
      </Grid>
      <Grid ColumnDefinitions="*,18,*" Height="160">
        <Button Background="#1677FF" BorderThickness="0" CornerRadius="16" Click="Publish_Click" Padding="26"><Grid ColumnDefinitions="58,*,28"><Border Width="52" Height="52" CornerRadius="14" Background="#3B8CFF"><PathIcon Width="27" Foreground="White" Data="M4,18L20,12L4,6L4,11L15,12L4,13Z"/></Border><StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center" Spacing="7"><TextBlock Text="发布本地服务" Foreground="White" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="将这台电脑上的服务分享出去" Foreground="#DCEBFF" FontSize="13" TextWrapping="Wrap"/></StackPanel><PathIcon Grid.Column="2" Width="22" Foreground="White" Data="M5,12H19M13,6L19,12L13,18"/></Grid></Button>
        <Button Grid.Column="2" Background="White" BorderBrush="#DCE5F2" BorderThickness="1" CornerRadius="16" Click="Connect_Click" Padding="26"><Grid ColumnDefinitions="58,*,28"><Border Width="52" Height="52" CornerRadius="14" Background="#EAF2FF"><PathIcon Width="27" Foreground="#1677FF" Data="M10,13A5,5 0 0,0 17,13L20,10A5,5 0 0,0 13,3L11,5M14,11A5,5 0 0,0 7,11L4,14A5,5 0 0,0 11,21L13,19"/></Border><StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center" Spacing="7"><TextBlock Text="连接分享服务" Foreground="#14213D" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="使用分享码或 .ptlink 文件连接" Foreground="#697386" FontSize="13" TextWrapping="Wrap"/></StackPanel><PathIcon Grid.Column="2" Width="22" Data="M5,12H19M13,6L19,12L13,18"/></Grid></Button>
      </Grid>
      <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="16" MinHeight="210" Padding="26"><Grid RowDefinitions="36,*"><TextBlock Text="最近使用" FontSize="18" FontWeight="SemiBold" Foreground="#14213D"/><StackPanel x:Name="EmptyState" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10"><Border Width="48" Height="48" CornerRadius="14" Background="#F2F5F9"><PathIcon Width="23" Foreground="#A8B2C3" Data="M6,5H18M6,12H18M6,19H18"/></Border><TextBlock Text="暂无最近使用的服务" Foreground="#909BAD" FontSize="14"/></StackPanel><ItemsControl x:Name="RecentItems" Grid.Row="1" IsVisible="False"><ItemsControl.ItemTemplate><DataTemplate x:DataType="models:RecentService"><Border Padding="12,10" Margin="0,3" CornerRadius="9" Background="#F8FAFD"><Grid ColumnDefinitions="90,*,Auto"><TextBlock Text="{Binding Protocol}" FontWeight="SemiBold" Foreground="#1677FF"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Address}" Foreground="#697386" FontSize="12"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding LastUsedUtc}" Foreground="#909BAD" FontSize="11"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Grid></Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
