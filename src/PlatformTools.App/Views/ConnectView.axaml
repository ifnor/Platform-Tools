<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="PlatformTools.App.Views.ConnectView">
  <ScrollViewer><StackPanel Margin="40,28,40,36" Spacing="16" MaxWidth="900">
    <TextBlock Text="连接分享服务" FontSize="30" FontWeight="Bold"/><TextBlock Text="粘贴分享码或导入 .ptlink 文件，无需手动输入 cloudflared 命令。" Foreground="#697386" FontSize="15" TextWrapping="Wrap"/>
    <Border Margin="0,10,0,0" Padding="26" CornerRadius="16" Background="White" BorderBrush="#E2E8F0" BorderThickness="1"><StackPanel Spacing="16"><TextBlock Text="分享码" FontWeight="SemiBold"/><TextBox x:Name="ShareCodeBox" PlaceholderText="在这里粘贴分享码" AcceptsReturn="True" MinHeight="84" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Spacing="10"><Button Content="解析分享码" Background="#1677FF" Foreground="White" CornerRadius="9" Padding="22,10" Click="Parse_Click"/><Button Content="导入 .ptlink 文件" CornerRadius="9" Padding="20,10" Click="Import_Click"/></StackPanel></StackPanel></Border>
    <Border x:Name="ProfileCard" IsVisible="False" Padding="24" CornerRadius="16" Background="#F2F7FF" BorderBrush="#CFE0FA" BorderThickness="1"><StackPanel Spacing="12"><TextBlock x:Name="ProfileNameText" FontSize="19" FontWeight="SemiBold"/><TextBlock x:Name="ProfileDetailsText" Foreground="#52637A" TextWrapping="Wrap"/><Grid ColumnDefinitions="*,180" ColumnSpacing="14"><StackPanel Spacing="6"><TextBlock Text="本地连接端口" FontWeight="SemiBold"/><TextBlock Text="本机应用将连接这个端口" Foreground="#697386" FontSize="12"/></StackPanel><NumericUpDown x:Name="LocalPortBox" Grid.Column="1" Minimum="1" Maximum="65535"/></Grid><TextBlock x:Name="ConnectionHintText" Foreground="#52637A" FontFamily="Cascadia Mono, monospace" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Spacing="10"><Button x:Name="ConnectButton" Content="开始连接" Background="#1677FF" Foreground="White" CornerRadius="9" Padding="22,10" Click="Connect_Click"/><Button x:Name="DisconnectButton" Content="断开" IsEnabled="False" CornerRadius="9" Padding="20,10" Click="Disconnect_Click"/><Button Content="复制连接命令" Click="CopyCommand_Click"/></StackPanel></StackPanel></Border>
    <TextBlock x:Name="StatusText" Foreground="#697386" TextWrapping="Wrap"/>
  </StackPanel></ScrollViewer>
</UserControl>
