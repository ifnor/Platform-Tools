<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:PlatformTools.App.Views" xmlns:c="using:PlatformTools.App.Controls" x:Class="PlatformTools.App.MainWindow"
        Title="Platform Tools" Icon="avares://PlatformTools/Assets/platform-tools.ico" Width="1040" Height="680" MinWidth="720" MinHeight="440"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource PageBrush}"
        FontFamily="Inter, Microsoft YaHei UI, PingFang SC, Noto Sans CJK SC">
  <Window.Styles>
    <Style Selector="Button.nav"><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Height" Value="48"/><Setter Property="Margin" Value="12,3"/><Setter Property="Padding" Value="16,0"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="FontSize" Value="15"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="CornerRadius" Value="10"/></Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/></Style>
    <Style Selector="Button.nav.active"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter Property="Foreground" Value="#3087EF"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style Selector="Button.nav TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style>
  </Window.Styles>
  <LayoutTransformControl x:Name="AdaptiveContent">
  <Grid ColumnDefinitions="238,*">
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="106,*,62">
        <StackPanel Orientation="Horizontal" Margin="22,0" VerticalAlignment="Center">
          <c:BrandMark Width="38" Height="38"/><StackPanel Margin="12,0,0,0" VerticalAlignment="Center" Spacing="3"><TextBlock Text="Platform Tools" FontSize="17" FontWeight="Bold"/><TextBlock Text="CONNECT WITH CONFIDENCE" FontSize="8" LetterSpacing="1.1" Classes="muted"/></StackPanel>
        </StackPanel>
        <StackPanel Grid.Row="1">
          <Button x:Name="HomeButton" Classes="nav active" Click="Home_Click"><StackPanel Orientation="Horizontal" Spacing="12"><PathIcon Width="20" Data="M3,11L12,3L21,11V21H14V15H10V21H3Z"/><TextBlock Text="首页"/></StackPanel></Button>
          <Button x:Name="PublishButton" Classes="nav" Click="Publish_Click"><StackPanel Orientation="Horizontal" Spacing="12"><PathIcon Width="20" Data="M4,18L20,12L4,6L4,11L15,12L4,13Z"/><TextBlock Text="发布服务"/></StackPanel></Button>
          <Button x:Name="ConnectButton" Classes="nav" Click="Connect_Click"><StackPanel Orientation="Horizontal" Spacing="12"><PathIcon Width="20" Data="M10,13A5,5 0 0,0 17,13L20,10A5,5 0 0,0 13,3L11,5M14,11A5,5 0 0,0 7,11L4,14A5,5 0 0,0 11,21L13,19"/><TextBlock Text="连接服务"/></StackPanel></Button>
          <Button x:Name="SettingsButton" Classes="nav" Click="Settings_Click"><StackPanel Orientation="Horizontal" Spacing="12"><PathIcon Width="20" Data="M12,8A4,4 0 1,0 12,16A4,4 0 1,0 12,8M4,12A8,8 0 0,1 4.3,9.8L2,8L4,4L6.7,5A8,8 0 0,1 10,3.2L10.5,0H13.5L14,3.2A8,8 0 0,1 17.3,5L20,4L22,8L19.7,9.8A8,8 0 0,1 19.7,14.2L22,16L20,20L17.3,19A8,8 0 0,1 14,20.8L13.5,24H10.5L10,20.8A8,8 0 0,1 6.7,19L4,20L2,16L4.3,14.2A8,8 0 0,1 4,12Z"/><TextBlock Text="设置"/></StackPanel></Button>
        </StackPanel>
        <TextBlock Grid.Row="2" Text="简单 · 安全 · 连接世界" Margin="24,0" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" FontSize="12"/>
      </Grid>
    </Border>
    <Grid Grid.Column="1" RowDefinitions="64,*">
      <Border Background="{DynamicResource PageBrush}" Padding="28,12"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10"><Button Click="Settings_Click" CornerRadius="18" Padding="14,7" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"><StackPanel Orientation="Horizontal" Spacing="8"><Ellipse x:Name="AccountStatusDot" Width="8" Height="8" VerticalAlignment="Center" Fill="#8B99AD"/><TextBlock x:Name="CloudflareStatusText" Text="Cloudflare · 未登录" Foreground="{DynamicResource InkBrush}" FontSize="13"/></StackPanel></Button><Button Width="38" Height="38" CornerRadius="11" Background="{DynamicResource SoftBrush}" BorderThickness="0" Click="Theme_Click" ToolTip.Tip="切换明暗主题"><Path Width="20" Height="20" Stroke="{DynamicResource InkBrush}" StrokeThickness="1.6" StrokeLineCap="Round" Data="M10 1 V3 M10 17 V19 M1 10 H3 M17 10 H19 M3.6 3.6 L5 5 M15 15 L16.4 16.4 M15 5 L16.4 3.6 M3.6 16.4 L5 15 M10 6 A4 4 0 1 0 10 14 A4 4 0 1 0 10 6"/></Button></StackPanel></Border>
      <ContentControl x:Name="PageHost" Grid.Row="1"/>
    </Grid>
  </Grid>
  </LayoutTransformControl>
</Window>
